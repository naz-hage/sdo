<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <Version></Version>
	  <AssemblyVersion></AssemblyVersion>
	  <Authors>naz-hage</Authors>
	  <Company>naz-hage</Company>
	  <Product>Simple DevOps Operations</Product>
	  <Copyright>2020-XXXX</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AssemblyName>sdo</AssemblyName>
	<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
	<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
  </PropertyGroup>

	<ItemGroup>
		<AllowedOutputExtensionsInPackageBuildOutputFolder Remove=".pdb" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SdoTests" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\dev-setup\apps.yaml" Link="apps.yaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	  <None Update="Resources\common.targets" Link="common.targets" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	  <None Update="Resources\ngit.targets" Link="ngit.targets" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	  <None Update="Resources\sdo.targets" Link="sdo.targets" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	  <None Include="..\scripts\module-package\sdo-scripts.psd1;" Link="sdo-scripts.psd1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	  <None Include="..\scripts\module-package\sdo-scripts.psm1;" Link="sdo-scripts.psm1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Resources\mapping.md" LogicalName="Sdo.mapping.md" />
	  <EmbeddedResource Include="Resources\Nbackup.json" LogicalName="Sdo.Resources.Nbackup.json" />
	  <EmbeddedResource Include="Resources\common.targets" LogicalName="nb.resources.common.targets" />
	  <EmbeddedResource Include="Resources\ngit.targets" LogicalName="nb.resources.ngit.targets" />
	  <EmbeddedResource Include="Resources\sdo.targets" LogicalName="nb.resources.sdo.targets" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
	  <PackageReference Include="sdo-launcher" Version="2.6.0" />
	  <PackageReference Include="System.CommandLine" Version="2.0.13" />
	  <PackageReference Include="YamlDotNet" Version="18.1.0" />
	</ItemGroup>

	<PropertyGroup>
	  <StartupObject>Sdo.Program</StartupObject>
	</PropertyGroup>

</Project>