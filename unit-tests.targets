<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Target Name="UNIT_TEST_ALL">
        <Message Text="Running all SDO unit tests..." />
        <Exec Command='dotnet test "$(SolutionDir)\SdoTests\SdoTests.csproj" --configuration Release --logger trx --results-directory:"$(SolutionDir)TestResults"' WorkingDirectory="$(SolutionDir)" />
        <Message Text="All SDO unit tests complete." />
    </Target>

</Project>
